#!/usr/bin/env python3
"""Lightweight live-page verifier for Milkman static pages."""
from __future__ import annotations

import argparse
import hashlib
import json
import sys
import urllib.request
from pathlib import Path


def sha(b: bytes) -> str:
    return hashlib.sha256(b).hexdigest()


def fetch(url: str) -> tuple[int, bytes]:
    req = urllib.request.Request(url, headers={"User-Agent": "milkman-verify-live/1.0"})
    with urllib.request.urlopen(req, timeout=30) as r:
        return int(r.status), r.read()


def browser_check(url: str, width: int, height: int) -> dict:
    result = {"browser_ok": False, "console_errors": [], "page_errors": [], "overflow_px": None, "has_bad_values": None, "title": None}
    try:
        from playwright.sync_api import sync_playwright
    except Exception as exc:
        result["browser_skipped"] = f"playwright unavailable: {exc}"
        return result
    try:
        with sync_playwright() as p:
            browser = p.chromium.launch(executable_path="/snap/bin/chromium", args=["--no-sandbox", "--disable-gpu"])
            page = browser.new_page(viewport={"width": width, "height": height})
            page.on("console", lambda msg: result["console_errors"].append(msg.text) if msg.type in {"error", "warning"} else None)
            page.on("pageerror", lambda exc: result["page_errors"].append(str(exc)))
            page.goto(url, wait_until="networkidle", timeout=60000)
            metrics = page.evaluate("""() => ({
              title: document.title,
              scrollWidth: document.documentElement.scrollWidth,
              clientWidth: document.documentElement.clientWidth,
              text: document.body ? document.body.innerText : ''
            })""")
            browser.close()
        result["title"] = metrics.get("title")
        result["overflow_px"] = max(0, int(metrics.get("scrollWidth", 0)) - int(metrics.get("clientWidth", 0)))
        text = metrics.get("text") or ""
        result["has_bad_values"] = any(x in text for x in ["NaN", "undefined", "Infinity"])
        result["browser_ok"] = not result["page_errors"] and not result["console_errors"] and result["overflow_px"] <= 2 and not result["has_bad_values"]
    except Exception as exc:
        result["browser_exception"] = str(exc)
    return result


def main() -> int:
    ap = argparse.ArgumentParser(description="Verify live URL fetch, optional local hash, and basic browser health.")
    ap.add_argument("url")
    ap.add_argument("--local", help="Local file expected to match live bytes")
    ap.add_argument("--width", type=int, default=430)
    ap.add_argument("--height", type=int, default=1200)
    ap.add_argument("--no-browser", action="store_true")
    args = ap.parse_args()

    status, body = fetch(args.url)
    out = {"url": args.url, "http_status": status, "bytes": len(body), "sha256": sha(body)}
    exit_code = 0 if 200 <= status < 300 else 1
    if args.local:
        local = Path(args.local).expanduser().resolve()
        local_bytes = local.read_bytes()
        out["local"] = str(local)
        out["local_sha256"] = sha(local_bytes)
        out["live_matches_local"] = out["local_sha256"] == out["sha256"]
        if not out["live_matches_local"]:
            exit_code = 1
    if not args.no_browser:
        out.update(browser_check(args.url, args.width, args.height))
        if out.get("browser_ok") is False and "browser_skipped" not in out:
            exit_code = 1
    print(json.dumps(out, indent=2, sort_keys=True))
    return exit_code


if __name__ == "__main__":
    raise SystemExit(main())
